{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sass: watch",
      "type": "npm",
      "script": "watch:css",
      "isBackground": true,
      "problemMatcher": {
        "owner": "scss",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(Error|.*):\\s+(.*)$",
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Compiling",
          "endsPattern": "Sass is watching for changes"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      }
    }
  ]
}
